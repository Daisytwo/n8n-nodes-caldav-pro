# Template for smoke-test.js credentials.
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# excluded from the npm package — it must never be committed or published.
#
# Use an app password generated for this purpose, not your account password:
#   https://manager.infomaniak.com -> Security -> Application passwords
# Revoke it once you are done testing.

CALDAV_SERVER=https://sync.infomaniak.com/

# Infomaniak: the SHORT username (e.g. abc12345), NOT your email address.
# Find it at https://config.infomaniak.com/ under Thunderbird or Apple profile.
CALDAV_USERNAME=

CALDAV_PASSWORD=

{
  "name": "n8n-nodes-caldav-pro",
  "version": "3.1.2",
  "description": "n8n community node for CalDAV calendars (Infomaniak, NextCloud, iCloud, Fastmail). Usable as AI Agent tool.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "caldav",
    "calendar",
    "infomaniak",
    "nextcloud",
    "icloud",
    "ical",
    "ai-agent"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Daisytwo/n8n-nodes-caldav-pro",
  "author": {
    "name": "Daisytwo"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Daisytwo/n8n-nodes-caldav-pro.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-icons.mjs",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials",
    "lintfix": "eslint nodes credentials --fix",
    "lint:selftest": "node scripts/lint-selftest.mjs",
    "check:package": "node scripts/check-package.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:dryrun": "node scripts/smoke-test-dryrun.mjs",
    "prepublishOnly": "npm run build && npm run lint:selftest && npm run lint && npm test && npm run check:package"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/CalDavApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/CalDav/CalDav.node.js"
    ]
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.1",
    "ical.js": "^2.1.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=20.15"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.39.5",
    "eslint-plugin-n8n-nodes-base": "^1.16.1",
    "n8n-workflow": "*",
    "prettier": "^3.3.2",
    "typescript": "^5.5.3",
    "vitest": "^3.2.7"
  }
}

# No trailing slash: a shared install is often linked in as a symlink, which a
# directory-only pattern would not ignore.
node_modules
dist/
*.log
.DS_Store
.env
*.tsbuildinfo

# Superseded by smoke-test.js, which covers everything this did and more.
e2e-test.js

# smoke-test.js is tracked: it holds no credentials, only references to
# CALDAV_* environment variables. The credentials themselves live in .env,
# which is ignored above.

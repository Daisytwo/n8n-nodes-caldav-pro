{
  "compilerOptions": {
    "strict": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "removeComments": true,
    "useUnknownInCatchVariables": false,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "strictNullChecks": true,
    "preserveConstEnums": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "incremental": true,
    // Keep the build cache out of dist/ — package.json "files" ships that
    // directory wholesale, and .npmignore does not apply inside it.
    "tsBuildInfoFile": "./node_modules/.cache/caldav-pro.tsbuildinfo",
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "outDir": "./dist/",
    "rootDir": "./"
  },
  "include": ["credentials/**/*", "nodes/**/*", "nodes/**/*.json"],
  "exclude": ["node_modules", "dist"]
}
